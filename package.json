{
  "name": "correobajolupa-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend de CorreoBajoLupa: análisis explicable de correos sospechosos.",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "api:types": "openapi-typescript ../correobajolupa-api/contract/openapi.json -o src/api/schema.d.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@microsoft/focusgroup-polyfill": "1.6.0",
    "lucide-react": "^1.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
